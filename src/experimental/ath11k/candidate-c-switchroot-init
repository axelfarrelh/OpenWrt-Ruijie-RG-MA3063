#!/bin/sh
set -eu

export INITRAMFS=1

fail() {
	echo "Candidate C switch-root failed: $*" >&2
	sleep 10
	reboot -f
	sleep 30
	exec /bin/ash
}

mkdir -p /rom /overlay/upper /overlay/work /new_root
mount -t proc proc /proc || fail "cannot mount /proc"
mount -t sysfs sysfs /sys || fail "cannot mount /sys"

i=0
while [ ! -f /sys/class/block/ubiblock0_3/dev ] && [ "$i" -lt 15 ]; do
	sleep 1
	i=$((i + 1))
done

[ -f /sys/class/block/ubiblock0_3/dev ] || fail "ubiblock0_3 not found"
device=$(cat /sys/class/block/ubiblock0_3/dev)
major=${device%:*}
minor=${device#*:}
mknod /dev/ubiblock0_3 b "$major" "$minor" || fail "cannot create ubiblock0_3"
mount -t squashfs -o ro /dev/ubiblock0_3 /rom || fail "cannot mount ubi_rootfs"
mount -t tmpfs -o noatime,mode=0755 candidate-c-overlay /overlay ||
	fail "cannot mount temporary overlay"
mkdir -p /overlay/upper/lib/modules/6.12.94 /overlay/work

for module in ath11k.ko ath11k_ahb.ko ath11k_pci.ko; do
	source="/lib/modules/6.12.94/$module"
	[ -f "$source" ] || fail "$source not found"
	cp "$source" "/overlay/upper/lib/modules/6.12.94/$module" ||
		fail "cannot stage $module"
done

mkdir -p /overlay/upper/etc/init.d /overlay/upper/etc/rc.d
cat > /overlay/upper/etc/candidate-c-switchroot <<'EOF'
Candidate C combined OEM-like rings, firmware memory mode 2, and private RXDMA page-frag caches
EOF

cat > /overlay/upper/etc/init.d/candidate-c-guard <<'EOF'
#!/bin/sh /etc/rc.common

START=99
STOP=01
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh /usr/sbin/candidate-c-guard
	procd_set_param respawn 5 5 0
	procd_close_instance
}
EOF
chmod 0755 /overlay/upper/etc/init.d/candidate-c-guard
ln -s ../init.d/candidate-c-guard /overlay/upper/etc/rc.d/S99candidate-c-guard

mkdir -p /overlay/upper/usr/sbin
cat > /overlay/upper/usr/sbin/candidate-c-guard <<'EOF'
#!/bin/sh
set -u

log_dir=/overlay/candidate-c-logs
samples="$log_dir/memory.tsv"
events="$log_dir/events.log"
mkdir -p "$log_dir"

snapshot() {
	name=$1
	dir="$log_dir/$name"
	mkdir -p "$dir"
	cp /proc/meminfo "$dir/meminfo" 2>/dev/null || true
	cp /proc/net/sockstat "$dir/sockstat" 2>/dev/null || true
	cp /proc/net/softnet_stat "$dir/softnet_stat" 2>/dev/null || true
	cp /proc/buddyinfo "$dir/buddyinfo" 2>/dev/null || true
	cp /proc/vmstat "$dir/vmstat" 2>/dev/null || true
	ps w > "$dir/ps" 2>/dev/null || true
	ip link show > "$dir/ip-link" 2>/dev/null || true
	wifi status > "$dir/wifi-status" 2>/dev/null || true
	dmesg > "$dir/dmesg" 2>/dev/null || true
}

trip() {
	reason=$1
	date '+%Y-%m-%dT%H:%M:%S%z' | tr -d '\n' >> "$events"
	printf '\t%s\n' "$reason" >> "$events"
	snapshot "trip-$(date +%s)"
	touch /overlay/candidate-c-guard-tripped
	wifi down >> "$events" 2>&1 || true
	while :; do
		sleep 3600
	done
}

printf 'epoch\tuptime_s\tmem_available_kb\tmem_free_kb\tslab_kb\tsreclaimable_kb\tsunreclaim_kb\tshmem_kb\n' > "$samples"
snapshot boot

while :; do
	epoch=$(date +%s)
	uptime_s=${SECONDS:-$(cut -d. -f1 /proc/uptime)}
	mem_available=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)
	mem_free=$(awk '/^MemFree:/ {print $2}' /proc/meminfo)
	slab=$(awk '/^Slab:/ {print $2}' /proc/meminfo)
	sreclaimable=$(awk '/^SReclaimable:/ {print $2}' /proc/meminfo)
	sunreclaim=$(awk '/^SUnreclaim:/ {print $2}' /proc/meminfo)
	shmem=$(awk '/^Shmem:/ {print $2}' /proc/meminfo)
	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
		"$epoch" "$uptime_s" "$mem_available" "$mem_free" "$slab" \
		"$sreclaimable" "$sunreclaim" "$shmem" >> "$samples"

	[ "$mem_available" -ge 24576 ] || trip "MemAvailable below 24576 kB"

	if dmesg | tail -n 200 | grep -Eqi 'Out of memory|Killed process|ath11k.*(fatal|crash)|remoteproc.*crash|kernel BUG|Unable to handle kernel|unbalanced.*IRQ'; then
		trip "fatal kernel or ath11k message detected"
	fi

	sleep 5
done
EOF
chmod 0755 /overlay/upper/usr/sbin/candidate-c-guard

mount -t overlay overlay \
	-o noatime,lowerdir=/rom,upperdir=/overlay/upper,workdir=/overlay/work \
	/new_root || fail "cannot mount overlay root"

mkdir -p /new_root/dev /new_root/proc /new_root/sys /new_root/rom /new_root/overlay
mount -t tmpfs -o mode=0755 tmpfs /new_root/dev || fail "cannot mount new /dev"
cp -a /dev/. /new_root/dev/ || fail "cannot populate new /dev"
mount -o move /proc /new_root/proc || fail "cannot move /proc"
mount -o move /sys /new_root/sys || fail "cannot move /sys"
mount -o move /rom /new_root/rom || fail "cannot move /rom"
mount -o move /overlay /new_root/overlay || fail "cannot move /overlay"

echo "Starting installed OpenWrt with Candidate C modules from RAM"
exec switch_root /new_root /sbin/init
